<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.telona" name="[COLOR FF00E5FF]Repositório[/COLOR] [COLOR FFB565FF]Telona[/COLOR]" version="1.0.0" provider-name="Nogueira01">
  <extension point="xbmc.addon.repository" name="Repositório Telona">
    <dir>
      <info compressed="false">https://nogueira01.github.io/cinetelona/addons.xml</info>
      <checksum>https://nogueira01.github.io/cinetelona/addons.xml.md5</checksum>
      <datadir zip="true">https://nogueira01.github.io/cinetelona/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="pt_br">Repositório Oficial Cine Telona</summary>
    <description lang="pt_br">Instalação e atualizações automáticas do Cine Telona e Elementum.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>

<addon id="plugin.video.cinetelona" name="[COLOR FF00E5FF]Cine[/COLOR] [COLOR FFB565FF]Telona[/COLOR]" version="1.6.0" provider-name="Nogueira01">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="pt_br">Filmes e Séries no Kodi</summary>
    <description lang="pt_br">Catálogo moderno de Filmes e Séries com reprodução via Elementum.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>

<addon id="plugin.video.elementum" name="Elementum" version="0.1.117" provider-name="elgatito">
  <requires>
    <import addon="xbmc.addon" version="16.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="navigation.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Elementum: Media streaming</summary>
    <description lang="pt_br">Motor de streaming via torrent para o Cine Telona.</description>
